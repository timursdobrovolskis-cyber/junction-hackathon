{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/coach.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/calendar.js": {
      "includeFiles": "server/calendar/**",
      "maxDuration": 20
    },
    "api/calendar-feed.js": {
      "includeFiles": "server/calendar/**",
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/preview.html",
      "permanent": false
    }
  ]
}
